@@ -0,0 +1,69 @@
+"""Syntax evidence distinguishes actual uses from names quoted in source prose."""
+
+import pytest
+
+from oce.infrastructure.astchunk.symbol_provider import TreeSitterSymbolProvider
+from oce.infrastructure.regex_symbol_provider import RegexSymbolProvider
+
+
+@pytest.fixture
+def verifier():
+    return TreeSitterSymbolProvider(RegexSymbolProvider())
+
+
+@pytest.mark.parametrize(
+    ("language", "content"),
+    [
+        ("python", 'def consume(value: "Target"):\n    return value'),
+        ("python", 'def produce() -> "Target":\n    return value'),
+        ("python", "from pkg import Target\nvalue = Target()"),
+        ("rust", "fn consume(value: Target) {}"),
+        ("go", "func consume(value Target) {}"),
+        ("java", "public Target consume(Target value) { return value; }"),
+        ("csharp", "public Target Consume(Target value) { return value; }"),
+        ("c", "Target *consume(Target *value) { return value; }"),
+        ("typescript", 'import { Target } from "pkg";\nfunction consume(x: Target) {}'),
+        ("javascript", "Target.prototype.consume = function() {};"),
+    ],
+)
+def test_code_uses_survive_without_a_same_file_penalty(verifier, language, content):
+    assert verifier.has_reference_use(
+        content=content, language=language, identifiers=("Target",)
+    )
+
+
+@pytest.mark.parametrize(
+    ("language", "content"),
+    [
+        ("python", "from pkg import Target"),
+        ("python", 'class Target:\n    """Example: Target()"""'),
+        ("python", 'def unrelated():\n    """Target()"""\n    return 1'),
+        ("python", 'value = "Target"'),
+        ("python", "Target = 7"),
+        ("python", "def Target():\n    return 1"),
+        ("python", 'def unrelated(x: str = "Target"):\n    return x'),
+        ("rust", "/// let x = Target::new();\npub fn unrelated() {}"),
+        ("rust", "use pkg::Target;"),
+        ("java", "import pkg.Target;"),
+        ("java", "/** Target value = new Target(); */\npublic void unrelated() {}"),
+        ("typescript", 'import { Target } from "pkg";'),
+        ("typescript", 'export { Target } from "pkg";'),
+        ("javascript", 'const Target = require("pkg");'),
+        ("javascript", "/** new Target() */\nfunction unrelated() {}"),
+        ("c", "/* Target *x; */\nvoid unrelated(void) {}"),
+        ("python", "value = AnotherTarget()"),
+    ],
+)
+def test_imports_declaration_names_and_prose_are_not_uses(verifier, language, content):
+    assert not verifier.has_reference_use(
+        content=content, language=language, identifiers=("Target",)
+    )
+
+
+def test_unavailable_grammar_and_oversized_fragment_add_no_evidence(verifier):
+    assert not verifier.has_reference_use(
+        content="Target()", language=None, identifiers=("Target",)
+    )
+    assert not verifier.has_reference_use(
+        content="Target()\n" * 10000, language="python", identifiers=("Target",)
+    )
