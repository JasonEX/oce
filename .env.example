# ==================== 功能开关总览 (ON / OFF) ====================
# 全部布尔开关集中速览；详细参数见下方各段。
# [LLM] 标记的功能分别按 kind 创建客户端，未配置对应凭据时共用 LLM_* fallback；
# 可选重排默认均关闭；专用 reranker 与 chat LLM 可单独或级联使用。
#
#   EMBED_ENABLED=true                               嵌入（关→只切块不写向量库）
#   CHUNKING_SEMANTIC_ENABLED=true                   cAST/结构化切块（关→纯 recursive）
#   WORKER_ENABLED=true                              后台嵌入 worker（关→需手动 embed_pending）
#   RETRIEVAL_EXACT_ENABLED=true                     SQL exact identifier recall
#   RETRIEVAL_LEXICAL_ENABLED=true                   允许按意图使用 SQL 词法召回
#   RETRIEVAL_PATH_INDEX_ENABLED=true                路径索引（文件名/路径召回增强）
#   RETRIEVAL_PATH_LOOKUP_ENABLED=true               SQL 精确路径/文件名后缀匹配
#   RETRIEVAL_MERGE_ADJACENT_ENABLED=true            同文件相邻片段合并
#   RETRIEVAL_RELATED_DEFINITIONS_ENABLED=true       允许语义关系查询附带相关定义摘要
#   RETRIEVAL_SOURCE_PRIORITY_ENABLED=true           source/test/docs 路径先验
#   RETRIEVAL_COVERAGE_SELECTION_ENABLED=true        focused/coverage 选择（关→Top-K）
#   RERANK_ENABLED=false                              API 重排（Qwen3-Reranker）
#   LLM_RERANK_ENABLED=false                  [LLM] chat-LLM 语义重排
#   RETRIEVAL_QUERY_REWRITE_ENABLED=false      [LLM] 查询改写（仅特殊场景增益，默认关）
#   RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true       多句查询拆分并行召回
#   MONITORING_ENABLED=true                         监控采集与落库（调用/token/资源）
#   LOG_FILE_ENABLED=false                          日志落盘（关→仅控制台输出）
#
# 检索链路：route → dense/exact/按意图 lexical/path 召回 → 融合 + 确定性头部
#           → source/工作集先验 → 专用/chat 重排 → 选择 → 相邻合并/相关定义摘要

# ==================== API Configuration ====================
# HTTP Bearer token accepted by the retrieval API.
# API 访问令牌（用于 Authorization: Bearer <token> 鉴权）
# 服务模式为共享部署，必须改为强随机值；请勿沿用个人模式的公开约定值 sk-opencontextengine。
API_KEY=replace-with-a-long-random-value
# Admin 接口密钥；留空则回落到 API_KEY，一旦配置则 admin 接口只认此 key
# ADMIN_API_KEY=

# --- CORS 跨域（供公共 GitHub Pages 上的 admin 前端调用）---
# Browser origins allowed to call the API (comma-separated).
# 允许访问 API 的浏览器来源，多个用逗号分隔。
# 默认已放行官方 admin 面板 https://oce-ai.github.io，用公共面板无需配置即可跨域调用。
# 部署在自定义域名/私有地址时用本项覆盖；设为空（CORS_ORIGINS=）则关闭 CORS。
# CORS_ORIGINS=https://oce-ai.github.io

# ==================== Database Configuration ====================
# PostgreSQL metadata store.
# PostgreSQL 连接字符串（格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名）
DB_URL=postgresql+asyncpg://oce:your_password_here@localhost:5432/oce
# 连接池大小（并发连接数）
# DB_POOL_SIZE=5
# 连接池最大溢出数（超过 POOL_SIZE 时的额外连接数）
# DB_MAX_OVERFLOW=5

# ==================== Milvus Configuration ====================
# Milvus dense vector store.
# Milvus 端点：HTTP 服务地址，或本地 Milvus Lite 文件路径（个人模式）
# MILVUS_ENDPOINT=http://localhost:19530
# Milvus collection 名称（自动创建，包含 dense 字段）
# MILVUS_COLLECTION_NAME=oce_chunks
# 路径索引 collection 名称（自动创建，存储路径向量）
# MILVUS_PATH_COLLECTION_NAME=oce_paths_v1
# HNSW 索引参数（影响召回质量与建库耗时）
MILVUS_HNSW_M=32
MILVUS_HNSW_EF_CONSTRUCTION=512
MILVUS_HNSW_EF_SEARCH=512

# ==================== Embedding Configuration ====================
# 向量嵌入服务配置（主要使用 SiliconFlow 兼容接口）

# Fallback when model_credentials has no active kind=embed row.
# 是否启用向量嵌入（false 时只切块不嵌入，用于测试）
# EMBED_ENABLED=true
# 嵌入服务 API 端点（OpenAI 兼容接口）
# EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
# 嵌入服务 API 密钥（从 model_credentials 表 kind=embed 动态加载，此为 fallback）
# 工作区源码片段会发送到该服务；私有代码请使用获准的内网或本地端点。
EMBED_API_KEY=your_embedding_api_key_here
# 嵌入模型名称（Qwen3-Embedding 生成 1024 维向量）
# EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# Query 侧指令（拼在 query 前，空则不加）
# EMBED_QUERY_INSTRUCTION=
# Query vector 进程内 LRU；只存 query 哈希与向量，不缓存源码或检索结果。0 表示禁用。
# EMBED_QUERY_CACHE_MAX_ENTRIES=256
# EMBED_QUERY_CACHE_TTL_SECONDS=600
# 向量维度（必须与模型输出维度匹配）
# EMBED_DIMENSIONS=1024
# 单批次最多嵌入的文本条数（避免超过 API 限制）
# EMBED_MAX_BATCH_SIZE=32
# 单批次输入的最大字符数（SiliconFlow 限制 32K 字符）
# EMBED_MAX_BATCH_CHARS=32000
# 单条输入的最大字符数（超过会自动分段嵌入后池化）
# EMBED_MAX_INPUT_CHARS=8000
# 分段嵌入时的重叠字符数（保证语义连续性）
# EMBED_INPUT_OVERLAP_CHARS=400
# 并发请求数上限（控制 API 调用速率）
# EMBED_MAX_CONCURRENCY=4

# ==================== LLM 客户端（重排 / 改写）====================
# ★ 两个功能各自按 kind 从 model_credentials 表解析凭证（kind=llm_rerank /
#   query_rewrite），可分别配置 key/base_url/model/tpm；本段为统一 fallback：
#     LLM_RERANK_ENABLED（本段）
#     RETRIEVAL_QUERY_REWRITE_ENABLED（Retrieval 段）
#   表中无对应 kind 的 active 行时回落本段。两项默认都关闭。

# --- 客户端连接 ---
# 开启任一 LLM 功能后，检索 query 和候选源码片段会发送到对应端点。
LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_PROXY=
# 默认模型（LLM 重排用；查询改写另用 RETRIEVAL_QUERY_REWRITE_MODEL）
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 单次 HTTP 请求超时（凭据表中的 timeout_seconds 可覆盖 transport 超时）
# LLM_TIMEOUT_SECONDS=30
# 接口 TPM 上限（>0 时客户端排队限流，防止连续 429）
# LLM_TPM_LIMIT=60000

# --- chat-LLM 语义重排 ---
# [开关] 全局比较候选代码语义；默认关闭是因为需要显式授权源码外发与额外延迟。
# 交互式部署先只开专用 reranker；质量优先级联再开启本项。
# LLM_RERANK_ENABLED=false
# 50 用于单独评估较宽的语义窗口；与专用 reranker 级联时建议先从 20 起测。
# 不同模型的排序质量、超时率和 token 成本差异很大，改默认值前应跑 paired benchmark。
# LLM_MAX_CANDIDATES=50
# LLM 最多提升的队首候选数；未选中候选不丢弃，仍交给 selector。
# LLM_OUTPUT_TOP_K=10
# 每候选送入 LLM 的代码字符上限
# LLM_SNIPPET_CHARS=1600
# 整个 LLM rerank 的延迟上限；超时无损回退到输入顺序。
# LLM_RERANK_TIMEOUT_SECONDS=15

# ==================== API 重排 (Qwen3-Reranker) ====================
# [开关] 交互式检索优先评估的低延迟相关性排序；默认仍关闭。
# 密钥空则复用 EMBED_API_KEY，也可从 model_credentials 表 kind=rerank 动态加载。
# RERANK_ENABLED=false
# RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=your_rerank_api_key_here
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# 最多提升到队首的候选数；其余候选保留给 selector。
# RERANK_TOP_N=50
# 送入 reranker 的 query 字符上限：交叉编码器对每个候选重读一遍 query；本项目的
# 0.6B 基准中，25K 字符 issue 曾让一次调用接近 15 秒。截断保留开头的问题描述。
# RERANK_MAX_QUERY_CHARS=2400
# 调用策略：adaptive 在 exact/path 证据已回答问题时跳过；always 每次都调
# RETRIEVAL_RERANK_POLICY=adaptive
# 随请求发送的任务说明（Qwen3-Reranker 等 instruction-aware 模型受益；置空不发送）
# RERANK_INSTRUCTION=Given a code search query, judge whether the code snippet implements, defines, or directly answers what the query asks for

# ==================== Retrieval Configuration ====================
# 检索管线配置：query → 多查询并行召回 → 结果融合 → Rerank → 覆盖度选择

# --- 评测消融开关（生产默认均开启）---
# 关闭结构化切块后必须使用干净数据目录重新索引，不能复用已有 chunks/vectors。
# CHUNKING_SEMANTIC_ENABLED=true
# CHUNKING_SEMANTIC_MAX_CHUNK_CHARS=1500
# CHUNKING_RECURSIVE_CHUNK_SIZE=6000
# CHUNKING_RECURSIVE_CHUNK_OVERLAP=200
# RETRIEVAL_EXACT_ENABLED=true
# RETRIEVAL_LEXICAL_ENABLED=true
# RETRIEVAL_PATH_LOOKUP_ENABLED=true
# RETRIEVAL_SOURCE_PRIORITY_ENABLED=true
# RETRIEVAL_COVERAGE_SELECTION_ENABLED=true
# RETRIEVAL_MERGE_ADJACENT_ENABLED=true
# RETRIEVAL_RELATED_DEFINITIONS_ENABLED=true

# --- 词法召回 ---
# 词法能力开启后用于 reference/call-chain/feature/overview/compound；
# symbol/path 在 exact/path 证据缺失时补跑，引号或报错短语会强制启用。
# 以下为召回条数 / RRF 权重 / 超时（超时后只用其他召回）。
# RETRIEVAL_LEXICAL_TOP_K=30
# RETRIEVAL_LEXICAL_WEIGHT=1.0
# RETRIEVAL_LEXICAL_TIMEOUT_SECONDS=2.0

# --- 源码头部槽位 ---
# feature/compound/call-chain/reference 查询的前 N 个结果优先给未被先验降权的
# 源码文件；reference 还会把被问符号自身的声明排到使用位置之后。明确问
# test/测试 的查询不适用；0 关闭。
# RETRIEVAL_SOURCE_HEAD_SLOTS=3

# --- 工作集增量先验 ---
# 请求 added_blobs 命中的乘性 boost；增量超过上限（首次全量同步）时不应用
# RETRIEVAL_WORKING_SET_BOOST=1.15
# RETRIEVAL_WORKING_SET_BOOST_MAX_BLOBS=50

# --- 二跳定义摘要 ---
# 用于调用链、feature 和 overview；compound 不扩展，避免多标识符扇出。
# 从前 N 条主结果抽取被引用标识符。相关定义与主结果共享
# RETRIEVAL_MAX_CONTEXT_CHARS，总量还受 RELATED_MAX_CHARS 限制；剩余不足 1000 时跳过。
# RETRIEVAL_RELATED_SOURCE_HITS=5
# RETRIEVAL_RELATED_MAX_SYMBOLS=8
# RETRIEVAL_RELATED_MAX_DEFINITIONS_PER_SYMBOL=3
# RETRIEVAL_RELATED_SNIPPET_LINES=12
# RETRIEVAL_RELATED_MAX_CHARS=4000

# --- 基础召回参数 ---
# 单查询模式下的向量召回条数（关闭查询分解时使用）
# RETRIEVAL_DEFAULT_TOP_K=50
# 最终返回的片段数量上限（软限制，实际受字符预算和文件数约束）
# RETRIEVAL_FINAL_SELECT_K=10
# Milvus 向量分数过滤阈值 [0.0-1.0]，0.0 表示不预过滤
# RETRIEVAL_VECTOR_THRESHOLD=0.0
# 最终置信度门槛 [0.0-1.0]，低于此分数的结果会被过滤
# RETRIEVAL_CONFIDENCE_FLOOR=0.0

# --- 多查询结果融合 ---
# 多查询结果的 RRF 融合平滑常数
# RETRIEVAL_RRF_K=60

# --- 多查询分解与并行召回 ---
# 是否将复杂查询拆分成多个子查询（保留完整查询 + 句子级子查询）
# RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true
# 查询总数上限（1 个主查询 + N-1 个子查询），1-8 之间
# RETRIEVAL_QUERY_MAX_QUERIES=4
# 子查询最少字符数，低于此长度的句子片段会被忽略
# RETRIEVAL_QUERY_MIN_FACET_CHARS=8
# 子查询在结果融合中的权重（主查询权重固定为 1.0）
# RETRIEVAL_QUERY_FACET_WEIGHT=0.75
# 多查询模式下每个查询的召回条数（避免候选池过大）
# 例：4 查询 × 20 条 = 80 条候选，vs 单查询 50 条
# RETRIEVAL_PER_QUERY_TOP_K=20

# --- 上下文剪枝与覆盖度 ---
# 单个文件最多返回的片段数（保证仓库覆盖度）
# RETRIEVAL_MAX_CHUNKS_PER_PATH=2
# 显式 symbol/path 查询采用 focused 模式时，单文件最多返回的片段数
# RETRIEVAL_FOCUSED_MAX_CHUNKS_PER_PATH=4
# 返回代码的总字符预算（硬限制，LLM 上下文窗口约束）
# 贪心填充策略：跳过放不下的大片段，继续尝试小片段
# RETRIEVAL_MAX_CONTEXT_CHARS=32000
# symbol/path focused 查询使用更紧凑的独立硬预算
# RETRIEVAL_FOCUSED_MAX_CONTEXT_CHARS=12000
# 同文件内片段重叠抑制阈值 [0.0-1.0]
# 重叠行数 / 较短片段行数 >= 此值时去重
# RETRIEVAL_OVERLAP_THRESHOLD=0.6

# --- chat LLM 重排路由 ---
# adaptive：exact symbol/path 有结构化证据时跳过；功能/流程/架构/复合查询进行语义判断。
# always：只要至少有两个候选就调用，用于全量语义重排或可复现对照。
# RETRIEVAL_LLM_RERANK_POLICY=adaptive

# --- 路径索引 ---
# [开关] 独立路径向量索引，与内容结果融合
# RETRIEVAL_PATH_INDEX_ENABLED=true

# --- 查询改写 [LLM]（依赖上方 LLM 客户端）---
# [开关] 仅跨语言文件名等特殊场景有增益，默认关；开启需先配置好 LLM 客户端
# RETRIEVAL_QUERY_REWRITE_ENABLED=false
# 改写模型（可与 LLM_MODEL 不同）
# RETRIEVAL_QUERY_REWRITE_MODEL=Qwen/Qwen2.5-7B-Instruct
# RETRIEVAL_QUERY_REWRITE_NUM=3

# ==================== Redis Queue Configuration ====================
# Redis task queue (for async upload/embedding).
# Redis 连接字符串（格式：redis://:密码@主机:端口/库号）
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0
# 队列键名前缀。实际会用到三个键：
#   {name}            主队列（待处理）
#   {name}:processing  处理中（worker 取走暂存，崩溃后可恢复）
#   {name}:pending     在飞哨兵集合（入队去重，防幽灵消息堆积）
# REDIS_QUEUE_NAME=oce:embed_queue

# ==================== Worker Configuration ====================
# Background worker (consumes embed queue).
# 是否启用后台 worker（false 时队列不消费，需手动触发 embed_pending）
# WORKER_ENABLED=true
# 并发消费协程数（每个协程独立 UoW，互不共享可变状态）
# WORKER_CONCURRENCY=2
# 每个协程一次最多处理的 blob 数（同批共享 embedding 请求）
# WORKER_BLOB_BATCH_SIZE=16
# 单个 blob 的最大重试次数（超限置 error 并清理 staging 原文）
# WORKER_MAX_RETRIES=3

# ==================== Logging Configuration ====================
# 日志落盘与格式（默认仅输出到控制台）。
# [开关] 是否启用日志落盘（false 时仅控制台输出）
# LOG_FILE_ENABLED=false
# 日志文件路径（留空 / None 时按运行模式自动推断）
# LOG_FILE_PATH=
# 轮转策略：'1 day' 按天 / '100 MB' 按大小
# LOG_ROTATION=100 MB
# 保留时长：'30 days' 按时间 / '10 files' 按文件数
# LOG_RETENTION=30 days
# 是否使用 JSON 格式（便于日志采集）
# LOG_FORMAT_JSON=false
# 日志级别（WARNING / INFO / DEBUG）
# LOG_LEVEL=INFO

# ==================== Monitoring Configuration ====================
# 调用 / token / 资源指标采集与落库，含检索阶段审计。
# [开关] 是否启用监控采集与落库（关→不写 metrics 表）
# MONITORING_ENABLED=true
# 缓冲区批量写库间隔秒数
# MONITORING_FLUSH_INTERVAL_SECONDS=5.0
# 单类指标缓冲上限，超出时保留最新样本
# MONITORING_FLUSH_MAX_BUFFER=500
# 资源采样间隔秒数（CPU / 内存等）
# MONITORING_RESOURCE_SAMPLE_INTERVAL_SECONDS=60.0
# 监控数据保留天数（GC 清理阈值）
# MONITORING_RETENTION_DAYS=30
# 监控数据清理任务运行间隔秒数
# MONITORING_CLEANUP_INTERVAL_SECONDS=3600.0
# 是否记录检索各阶段耗时与空回审计
# MONITORING_RETRIEVAL_AUDIT_ENABLED=true
# 检索审计是否存储 query 原文（默认关，隐私安全）
# MONITORING_STORE_QUERY_TEXT=false

# ==================== 高级/可选（有代码默认值，通常无需设置）====================
# 需要时取消注释以覆盖默认值。
# MILVUS_TOKEN=                          # Zilliz Cloud 认证 token
# MILVUS_DENSE_INDEX_TYPE=HNSW
# MILVUS_DENSE_METRIC_TYPE=COSINE
# EMBED_TIMEOUT_SECONDS=60
# EMBED_PROXY=
# RERANK_MIN_SCORE=0.05                  # API 重排最低分
# RERANK_TIMEOUT_SECONDS=60
# RETRIEVAL_EXACT_TIMEOUT_SECONDS=2.0
# RETRIEVAL_PATH_BOOST_WEIGHT=0.5        # 路径命中对同文件 chunk 的加权系数
# RETRIEVAL_PATH_TOP_K=20                # 每个查询变体从路径索引召回的文件数
# DB_ECHO=false                          # 打印 SQL 日志
