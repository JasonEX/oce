+    def has_reference_use(
+        self, *, content: str, language: str | None, identifiers: Sequence[str]
+    ) -> bool:
+        """Conservative body evidence for a recalled fragment, never index data.
+
+        Import bindings, declaration names and opaque prose cannot establish a
+        use. Quoted Python annotations are types, so they remain eligible.
+        Invalid fragments and unavailable grammars do not invent head evidence;
+        independently recorded SQL calls and inheritance remain usable.
+        """
+        if not identifiers or len(content.encode("utf-8")) > 64 * 1024:
+            return False
+        parser = self._parser(language) if language else None
+        if parser is None:
+            return False
+        try:
+            root = compat_parse(parser, content).root_node
+        except Exception as exc:
+            logger.debug("Reference fragment parse failed: {}", type(exc).__name__)
+            return False
+        wanted = frozenset(identifiers)
+        pending = [(root, False)]
+        while pending:
+            node, annotation = pending.pop()
+            kind = node.type
+            if kind == "ERROR" or "comment" in kind or "import" in kind:
+                continue
+            if kind in _IMPORT_TYPES or require_alias_names(node) is not None:
+                continue
+            if kind == "export_statement" and node.child_by_field_name("source"):
+                continue
+            if kind in _OPAQUE_TYPES or kind in _STRING_TYPES:
+                if language == "python" and annotation:
+                    text = node.text.decode("utf-8", errors="replace")
+                    if any(_word_in(name, text) for name in wanted):
+                        return True
+                continue
+            if kind.endswith("identifier") and not node.named_children:
+                if node.text.decode("utf-8", errors="replace") in wanted:
+                    return True
+            bindings = []
+            if (
+                is_definition_type(kind)
+                or "parameter" in kind
+                or kind in _ASSIGNMENT_TYPES
+                or kind.endswith("_declarator")
+            ):
+                for field in ("name", "declarator", "pattern", "left"):
+                    binding = node.child_by_field_name(field)
+                    if binding is not None and binding.type.endswith("identifier"):
+                        bindings.append((binding.start_byte, binding.end_byte))
+            type_nodes = [
+                node.child_by_field_name("type"),
+                node.child_by_field_name("return_type"),
+            ]
+            for child in reversed(node.named_children):
+                if (child.start_byte, child.end_byte) in bindings:
+                    continue
+                pending.append(
+                    (child, annotation or any(child is t for t in type_nodes))
+                )
