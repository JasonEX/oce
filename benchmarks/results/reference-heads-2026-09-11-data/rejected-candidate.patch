+"""Head admission follows recorded uses rather than the file declaring a name."""
+
+from oce.domain.services.query_classifier import QueryIntent, QueryRoute
+from oce.domain.services.ranking import (
+    HeadEvidence,
+    source_heads,
+    source_priority_factor,
+)
+from oce.domain.services.search import SearchHit, search_hit_key
+
+
+def hit(path, content, line=1):
+    return SearchHit(path, path, content, 1.0, start_line=line, end_line=line + 2)
+
+
+def test_same_file_call_and_type_use_lead_import_and_prose():
+    declaration = hit("src/target.py", "class Target: pass")
+    call = hit("src/target.py", "def construct(): return Target()", 20)
+    annotation = hit("src/target.py", "def consume(x: Target): return x", 40)
+    imported = hit("src/consumer.py", "from target import Target")
+    prose = hit("src/help.py", "# Example: Target()")
+    hits = [imported, prose, declaration, annotation, call]
+    evidence = HeadEvidence(
+        route=QueryRoute(QueryIntent.REFERENCE, targets=("Target",)),
+        identifiers=("Target",),
+        definitions=[declaration],
+        exact=[imported, declaration, call],
+        lexical=[prose, annotation],
+        use_sites=[call],
+        body_use_keys=frozenset({search_hit_key(annotation)}),
+    )
+    assert source_heads(
+        evidence, hits, source_priority_factor, slots=3, reference_fallback=True
+    ) == (
+        search_hit_key(call),
+        search_hit_key(annotation),
+    )
+
+
+def test_declaration_chunk_needs_a_separate_use_to_lead():
+    own_name = hit("src/item.py", "class Target: pass")
+    mixed = hit("src/target.py", "class Target: pass\nitem = Target()")
+    evidence = HeadEvidence(
+        route=QueryRoute(QueryIntent.REFERENCE, targets=("Target",)),
+        identifiers=("Target",),
+        definitions=[own_name, mixed],
+        exact=[own_name, mixed],
+        use_sites=[mixed],
+    )
+    assert source_heads(
+        evidence,
+        [own_name, mixed],
+        source_priority_factor,
+        slots=3,
+        reference_fallback=True,
+    ) == (search_hit_key(mixed),)
